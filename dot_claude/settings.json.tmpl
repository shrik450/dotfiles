{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "EnterWorktree"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/style-reminder.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-skill-sync.sh'",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true
  },
  "outputStyle": "Plain Language",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": false,
  "showTurnDuration": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": false,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(rm:-rf *)",
      "Writes to packages/litesheets/docker-compose.prod.yml"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: AllSpiceIO (GitHub org) — evidenced by remote `github.com:AllSpiceIO/connections-checker.git` and staging remote `staging.allspice.dev:GenAI/connections-checker.git`",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Internal (AllSpiceIO/connections-checker, via gh) — treat as non-public but org-internal, not fully private",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: .env file (gitignored) with keys for Anthropic, Gemini, OpenAI, AllSpice Hub, Digi-Key, Mouser, Google service account, Slack webhook, S3 eval bucket credentials — per .env.example; CI secrets referenced by name only: CLAUDE_CODE_OAUTH_TOKEN, DIGIKEY_CLIENT_ID, DIGIKEY_CLIENT_SECRET, DOCKERHUB_TOKEN, GENAI_EVAL_ALLSPICE_AUTH_TOKEN, GITHUB_TOKEN, SLACK_WEBHOOK_URL",
      "**Default / protected branches**: `main` (default), `main` protected via active ruleset (via gh)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: GitHub (github.com:AllSpiceIO/connections-checker.git) and AllSpice Hub staging (staging.allspice.dev:GenAI/connections-checker.git) — this repo's remotes only",
      "**Trusted internal domains**: staging.allspice.dev (this repo's staging remote host)",
      "**Trusted cloud buckets**: allspice-drcy-evals (S3, config-derived — not a confirmed upload destination; uploads of local data still require confirmation)",
      "**Key internal services**: AllSpice Hub API (via py-allspice library, per ~/.claude/CLAUDE.md)",
