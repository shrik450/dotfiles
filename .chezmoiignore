# This file is a template, so the OS checks in it work.

# Repository files that chezmoi must not copy to the home directory.
README.md

# Machine-local files that stay on the machine that needs them.
.config/fish/functions/logs.fish

# The homeserver deploy platform. It lives in its own git repo at ~/.config,
# so chezmoi must not manage or copy any of it. Keep this list in step with
# the service directories named in ~/.config/.gitignore.
.config/.gitignore
.config/README.md
.config/beszel
.config/caddy
.config/commonplace
.config/devdeploy
.config/hooks
.config/pocket-id
.config/tinyauth
.config/victorialogs
.config/webterm

# Build artifacts that must never enter the source state.
**/__pycache__
**/.ruff_cache
**/.DS_Store

{{ if ne .chezmoi.os "darwin" }}
# These tools run on macOS only.
.hammerspoon
.config/brew
.config/ghostty
.config/wezterm
{{ end }}

{{ if ne .chezmoi.os "linux" }}
# This directory applies to Linux only.
.config/packages
{{ end }}
